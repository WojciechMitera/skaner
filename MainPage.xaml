<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.MainPage"
             Title="Shopping lift"
             Background="#222222"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls">
    <ContentPage.Resources>
        <Style TargetType="Grid">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="labelka" TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="HeightRequest" Value="40"/>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="*,*" RowDefinitions="*">
        <Label
x:Name="codeValue"
Text="Code Value" IsVisible="False"/>
        <zxing:CameraBarcodeReaderView
                x:Name="cameraView"
                BarcodesDetected="cameraView_BarcodesDetected"
                IsTorchOn="False"
                IsDetecting="True"
                Grid.Column="0"
                Grid.Row="0"/>

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="1" Grid.Row="0" Spacing="15" Margin="130,00,0,0">
            <!--<HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="30">
                <Entry x:Name="entryadd" Grid.Column="0" Grid.Row="0" TextColor="White"></Entry>
                <Entry x:Name="quantity" Grid.Column="1" Grid.Row="0" TextColor="White"></Entry>
                <Button x:Name="add" Grid.Column="2" Grid.Row="0" HeightRequest="50" Text="Add" Clicked="add_Clicked"></Button>
            </HorizontalStackLayout>-->
            <CollectionView x:Name="list"
                ItemsSource="{Binding Products}"
                SelectionMode="Single"
                Grid.Column="0"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Grid.RowSpan="2">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8"
                  ColumnDefinitions="*,80"
                  RowDefinitions="Auto,1">

                            <!-- Nazwa produktu -->
                            <Label Text="{Binding Name}"
                       Grid.Column="0"
                       Style="{StaticResource labelka}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />

                            <!-- Ilość -->
                            <Label Text="{Binding Quantity}"
                       Grid.Column="1"
                       Style="{StaticResource labelka}"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       HorizontalTextAlignment="End" />

                            <!-- Separator -->
                            <BoxView Grid.Row="1"
                         Grid.ColumnSpan="2"
                         HeightRequest="1"
                         BackgroundColor="LightGray"
                         Margin="0,8,0,0" />

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button Grid.Column="2" Clicked="usunac" Grid.Row="3" HeightRequest="50" Text="-" WidthRequest="50"></Button>
                <Button Grid.Column="2" Clicked="Button_Clicked" Grid.Row="3" HeightRequest="50" Text="Delete"></Button>
                <Button Grid.Column="2" Clicked="dodaj" Grid.Row="3" HeightRequest="50" Text="+" WidthRequest="50"></Button>
            </HorizontalStackLayout>
            
        </VerticalStackLayout>



            

            
    </Grid>
    
    
   

    

</ContentPage>
